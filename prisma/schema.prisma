// Prisma schema for FlowForge MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Beat model - Stores instrumental beat metadata
model Beat {
  id              String   @id @default(uuid())
  title           String
  bpm             Int
  storageUrl      String   @map("storage_url")
  coverImage      String?  @map("cover_image")
  isPremium       Boolean  @default(false) @map("is_premium")
  genre           String?
  tags            String[] @default([])
  duration        Int?     // Duration in seconds
  artistName      String?  @map("artist_name")
  difficulty      String   @default("Medium") // "Easy", "Medium", "Hard"
  
  // User Uploads & Calibration
  uploaderId      String?  @map("uploader_id")
  offset          Float    @default(0) // Start point calibration in seconds
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  sessions        FreestyleSession[]
  favoritedBy     FavoriteBeat[]
  uploader        User?    @relation(fields: [uploaderId], references: [id])

  @@map("beats")
}

// Word model - Word library for prompts
model Word {
  id              String   @id @default(uuid())
  wordText        String   @unique @map("word_text")
  syllableCount   Int      @map("syllable_count")
  difficultyLevel Int      @map("difficulty_level") // 1 = Easy, 2 = Medium, 3 = Hard
  category        String?  // Optional: noun, verb, adjective, etc.
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([difficultyLevel])
  @@index([syllableCount])
  @@map("words")
}

// User model - NextAuth.js user accounts
// User model - NextAuth.js user accounts
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  username      String?   @unique
  bio           String?   @db.Text
  
  // Stripe fields
  customerId         String?   @unique @map("customer_id")
  subscriptionId     String?   @unique @map("subscription_id")
  subscriptionStatus String?   @default("free") @map("subscription_status")
  // Values: "free", "active", "past_due", "canceled", "trialing"
  
  role String @default("USER") // "USER", "SUPERADMIN"

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Social Links (JSON) - Keeping for profile display only
  socials       Json?

  // Relations
  accounts      Account[]
  sessions      Session[]
  freestyleSessions FreestyleSession[]
  
  // Word Vault
  collectedWords CollectedWord[]
  favoriteBeats FavoriteBeat[]
  uploadedBeats Beat[]

  // Achievements
  achievements UserAchievement[]

  @@map("users")
}

// Account model - NextAuth.js OAuth accounts
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Session model - NextAuth.js sessions
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// VerificationToken model - NextAuth.js email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// FreestyleSession model - Saved practice sessions
model FreestyleSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id") // Now required with auth
  beatId          String   @map("beat_id")
  title           String
  storageUrl      String?  @map("storage_url")
  durationSeconds Int      @map("duration_seconds")
  frequency       Int      @default(8) // 4, 8, or 16 bars
  difficulty      Int      @default(2) // 1 = Easy, 2 = Medium, 3 = Hard
  score           Int      @default(0) // Legacy score, might be repurposed
  vibe            String?  // "Hype", "Chill", "Locked In"
  mode            String   @default("solo") // "solo"
  restarts        Int      @default(0)
  playbacks       Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  beat            Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([beatId])
  @@index([createdAt])
  @@map("freestyle_sessions")
}

// Social: Favorite Beats
model FavoriteBeat {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  beatId    String   @map("beat_id")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beat      Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, beatId])
  @@index([userId])
  @@index([beatId])
  @@map("favorite_beats")
}


// Word Vault: Track unique words collected by user
model CollectedWord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  wordText  String   @map("word_text")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordText])
  @@index([userId])
  @@map("collected_words")
}

// Achievements System
model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "FIRST_SESSION"
  name        String
  description String
  icon        String   // e.g. Lucide icon name or emoji
  points      Int      @default(10) // Weighted value of achievement
  
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  achievementId String      @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}
