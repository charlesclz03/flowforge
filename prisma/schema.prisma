// Prisma schema for FlowForge MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Beat model - Stores instrumental beat metadata
model Beat {
  id              String   @id @default(uuid())
  title           String
  bpm             Int
  storageUrl      String   @map("storage_url")
  isPremium       Boolean  @default(false) @map("is_premium")
  genre           String?
  tags            String[] @default([])
  duration        Int?     // Duration in seconds
  artistName      String?  @map("artist_name")
  difficulty      String   @default("Medium") // "Easy", "Medium", "Hard"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  sessions        FreestyleSession[]
  favoritedBy     FavoriteBeat[]

  @@map("beats")
}

// Word model - Word library for prompts
model Word {
  id              String   @id @default(uuid())
  wordText        String   @unique @map("word_text")
  syllableCount   Int      @map("syllable_count")
  difficultyLevel Int      @map("difficulty_level") // 1 = Easy, 2 = Medium, 3 = Hard
  category        String?  // Optional: noun, verb, adjective, etc.
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([difficultyLevel])
  @@index([syllableCount])
  @@map("words")
}

// User model - NextAuth.js user accounts
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  username      String?   @unique
  bio           String?   @db.Text
  flowPoints    Int       @default(0) @map("flow_points")
  
  // Stripe fields
  customerId         String?   @unique @map("customer_id")
  subscriptionId     String?   @unique @map("subscription_id")
  subscriptionStatus String?   @default("free") @map("subscription_status")
  // Values: "free", "active", "past_due", "canceled", "trialing"
  
  role String @default("USER") // "USER", "SUPERADMIN"

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Social Links (JSON)
  socials       Json?

  // Gamification
  badges        String[]  @default([])

  // Relations
  accounts      Account[]
  sessions      Session[]
  freestyleSessions FreestyleSession[]

  @@map("users")
  
  // Relations: Social
  followedBy    Follow[] @relation("followedBy")
  following     Follow[] @relation("following")
  likes         Like[]
  comments      Comment[]
  favoriteBeats FavoriteBeat[]
  
  // Word Vault
  collectedWords CollectedWord[]
  
  // Voting
  votesCast      DuelVote[]

  // Messaging
  conversations  ConversationParticipant[]
  messagesSent   Message[]
  feedbackSent   Feedback[]
}

// Social: Follows
model Follow {
  followerId  String @map("follower_id")
  followingId String @map("following_id")

  follower    User   @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("followedBy", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// Social: Likes
model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  sessionId String   @map("session_id")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   FreestyleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@map("likes")
}

// Social: Comments
model Comment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  sessionId String   @map("session_id")
  content   String   @db.Text
  
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   FreestyleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([sessionId])
  @@map("comments")
}

// Account model - NextAuth.js OAuth accounts
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Session model - NextAuth.js sessions
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// VerificationToken model - NextAuth.js email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// FreestyleSession model - Saved practice sessions
model FreestyleSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id") // Now required with auth
  beatId          String   @map("beat_id")
  title           String
  storageUrl      String?  @map("storage_url")
  durationSeconds Int      @map("duration_seconds")
  frequency       Int      @default(8) // 4, 8, or 16 bars
  difficulty      Int      @default(2) // 1 = Easy, 2 = Medium, 3 = Hard
  score           Int      @default(0)
  vibe            String?  // "Hype", "Chill", "Locked In"
  mode            String   @default("solo") // "solo", "cypher"
  restarts        Int      @default(0)
  playbacks       Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  parentId        String?  @map("parent_id")
  parent          FreestyleSession? @relation("Duels", fields: [parentId], references: [id])
  duels           FreestyleSession[] @relation("Duels")

  // Relations
  beat            Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes           Like[]
  comments        Comment[]
  
  // Voting Relations
  duelVotesContext DuelVote[] @relation("DuelContext")
  duelVotesWon     DuelVote[] @relation("DuelWinner")

  @@index([userId])
  @@index([beatId])
  @@index([createdAt])
  @@index([parentId])
  @@map("freestyle_sessions")
}

// Social: Favorite Beats
model FavoriteBeat {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  beatId    String   @map("beat_id")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beat      Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, beatId])
  @@index([userId])
  @@index([beatId])
  @@map("favorite_beats")
}


// Word Vault: Track unique words collected by user
model CollectedWord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  wordText  String   @map("word_text")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordText])
  @@index([userId])
  @@map("collected_words")
}

// Community Voting for Duels
model DuelVote {
  id          String   @id @default(uuid())
  duelId      String   @map("duel_id")      // The parent/challenge session ID (The context)
  voterId     String   @map("voter_id")
  votedForId  String   @map("voted_for_id") // The specific session ID voted for

  duel        FreestyleSession @relation("DuelContext", fields: [duelId], references: [id], onDelete: Cascade)
  voter       User             @relation(fields: [voterId], references: [id], onDelete: Cascade)
  winner      FreestyleSession @relation("DuelWinner", fields: [votedForId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([voterId, duelId])
  @@index([duelId])
  @@map("duel_votes")
}

// Direct Messaging
model Conversation {
  id        String   @id @default(uuid())
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  lastReadAt     DateTime @default(now()) @map("last_read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  
  // Future: Audio messages?
  // audioUrl       String?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Feedback {
  id        String   @id @default(cuid())
  content   String
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}
