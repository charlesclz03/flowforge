{
  "name": "flowforge-freestyle",
  "version": "1.1.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "docs:check:links": "node scripts/docs/check-internal-links.mjs",
    "docs:check:drift": "node scripts/docs/check-canonical-drift.mjs",
    "docs:check:patch-notes": "node scripts/docs/check-patch-notes-sync.mjs",
    "docs:check:stubs": "node scripts/docs/check-stub-integrity.mjs",
    "docs:check": "npm run docs:check:links && npm run docs:check:drift && npm run docs:check:patch-notes && npm run docs:check:stubs",
    "check:release-env": "dotenv -e .env -e .env.local -e .env.production.local -- node scripts/check-release-env.mjs --mode=production",
    "check:release-env:local": "dotenv -e .env -e .env.local -e .env.production.local -- node scripts/check-release-env.mjs --mode=local --allow-local-urls",
    "check:release-env:vercel": "node scripts/check-vercel-env.mjs --environment=production",
    "verify:storage": "node scripts/verify-supabase-storage.js",
    "postinstall": "prisma generate"
  },
  "overrides": {
    "qs": "6.14.2",
    "minimatch": "10.2.4",
    "postcss": "$postcss",
    "serialize-javascript": "^7.0.4",
    "terser-webpack-plugin": "^5.3.17",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@headlessui/react": "^2.2.9",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.38.0",
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/supabase-js": "^2.81.1",
    "@uppy/core": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "easy-speech": "^2.4.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.552.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.13",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.0",
    "resend": "^6.6.0",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.3.1",
    "wavesurfer.js": "^7.12.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.24",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.12",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jsdom": "^25.0.0",
    "music-metadata": "^11.10.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
