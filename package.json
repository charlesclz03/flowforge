{
  "name": "flowforge-freestyle",
  "version": "0.9.1000",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "check:release-env": "dotenv -e .env -e .env.local -e .env.production.local -- node scripts/check-release-env.mjs --mode=production",
    "check:release-env:local": "dotenv -e .env -e .env.local -e .env.production.local -- node scripts/check-release-env.mjs --mode=local --allow-local-urls",
    "check:release-env:vercel": "node scripts/check-vercel-env.mjs --environment=production",
    "verify:storage": "node scripts/verify-supabase-storage.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.38.0",
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/supabase-js": "^2.81.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.552.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.13",
    "next-pwa": "^5.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.0",
    "resend": "^6.6.0",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.24",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.12",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jsdom": "^25.0.0",
    "music-metadata": "^11.10.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
